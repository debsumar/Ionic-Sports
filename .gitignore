# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www
/.kiro
.github/chatmodes/4.1-Beast.chatmode.md

# ---------------------------------------------------------------------------
# Secrets / credentials — NEVER commit these.
# Real values stay local only. Copy from the *.example.ts templates and fill in.
# ---------------------------------------------------------------------------

# Firebase / Google service config
google-services.json
GoogleService-Info.plist

# Environment configs (contain API keys, admin keys, prod endpoints)
/src/environments/environment.ts
/src/environments/environment.prod.ts
!/src/environments/*.example.ts

# Cordova signing / build credentials
build.json
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision

# Generic secret files
.env
.env.*
*.pem
serviceAccount*.json
credentials*.json
